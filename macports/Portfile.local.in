# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4
#
# LOCAL MacPorts port template for building FluxMarkdown from a working checkout
# (including uncommitted-to-upstream changes) instead of the published xykong
# release. It is NOT meant for the official MacPorts tree.
#
# Do not edit this file's placeholder tokens by hand — run
# scripts/create_macports_local_port.sh, which builds a source tarball from the
# current checkout and renders this template (with real checksums and a
# file:// distfile path) into a local ports tree.

PortSystem          1.0

name                flux-markdown
version             @VERSION@
categories          aqua sysutils
platforms           {darwin >= 21}
supported_archs     x86_64 arm64
license             GPL-3
maintainers         nomaintainer
homepage            https://github.com/rotojp/flux-markdown

description         Markdown previews in Finder QuickLook with diagrams and math
long_description    FluxMarkdown is a macOS QuickLook extension for Markdown files. \
                    It renders Mermaid diagrams, KaTeX math, GitHub Flavored Markdown \
                    (including Alerts), syntax-highlighted code blocks, Vega/Vega-Lite \
                    charts, and Graphviz DOT diagrams. This is a LOCAL build produced \
                    from a source checkout (Sparkle auto-update removed for MacPorts).

# Local distfile produced by scripts/create_macports_local_port.sh — this is a
# file:// path on the build machine, not a network download.
master_sites        file://@DISTPATH@/
distname            FluxMarkdown-@VERSION@-macports-source
worksrcdir          FluxMarkdown-@VERSION@
extract.suffix      .tar.gz

checksums           rmd160  @RMD160@ \
                    sha256  @SHA256@ \
                    size    @SIZE@

use_configure       no
use_xcode           yes

build {
    system -W ${worksrcpath} \
        "xcodebuild \
            -project FluxMarkdown.xcodeproj \
            -scheme Markdown \
            -configuration Release \
            -derivedDataPath ${workpath}/DerivedData \
            CODE_SIGN_IDENTITY='' \
            CODE_SIGNING_REQUIRED=NO \
            CODE_SIGN_ENTITLEMENTS='' \
            AD_HOC_CODE_SIGNING_ALLOWED=YES \
            MARKETING_VERSION=${version} \
            -quiet"
}

destroot {
    copy ${workpath}/DerivedData/Build/Products/Release/FluxMarkdown.app \
         ${destroot}${applications_dir}
}

post-activate {
    system "/usr/bin/xattr -cr ${applications_dir}/FluxMarkdown.app"
    system "/usr/bin/pluginkit -a \
        ${applications_dir}/FluxMarkdown.app/Contents/PlugIns/MarkdownPreview.appex"
    system "/usr/bin/qlmanage -r"
}
